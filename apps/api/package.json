    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@lifeos/eslint-config": "workspace:*",
    "@lifeos/tsconfig": "workspace:*",
    "@nestjs/testing": "^10.4.4",
    "@swc/core": "^1.7.26",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.11.1",
    "supertest": "^7.0.0",
