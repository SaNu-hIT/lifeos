# LifeOS API — environment template (docs/36 production readiness).
# Copy to .env and override for your environment. The API validates these at boot and
# FAILS FAST on anything invalid (docs/13 §4).

# Runtime
NODE_ENV=production            # development | test | production
PORT=3000
LOG_LEVEL=info                 # debug | info | warn | error

# Datastores
DATABASE_URL=postgres://user:pass@host:5432/lifeos
REDIS_URL=redis://host:6379

# Auth — MUST be a strong, unique secret in production (boot fails on the dev default).
AUTH_JWT_SECRET=change-me-to-a-long-random-secret

# AI provider (docs/adr/adr-0004). 'local' is the deterministic dev provider; any name
# registered via `registerAIProvider` (@lifeos/ai-core) works. 'openai' ships built in.
AI_PROVIDER=local
# OPENAI_API_KEY=sk-...                  # required when AI_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini               # chat/planning model
# OPENAI_EMBED_MODEL=text-embedding-3-small
# AI_REQUEST_TIMEOUT_MS=30000

# API edge hardening
RATE_LIMIT_RPM=600             # requests/min per principal; 0 disables
MAX_BODY_SIZE=1mb              # max request body

# Postgres connection pool (per instance)
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_CONN_TIMEOUT_MS=5000
